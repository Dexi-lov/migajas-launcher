# Copia este archivo como .env.social y completa estos valores una vez, como mantenedor.
# Usa la Project URL y la clave pública Publishable/anon de Supabase.
# Nunca coloques aquí una clave secret o service_role.
MIGAJAS_SUPABASE_URL=
MIGAJAS_SUPABASE_PUBLISHABLE_KEY=

# Servicio de comunidad (Cloudflare D1). La URL es pública; las claves privadas van en Wrangler Secrets.
MIGAJAS_COMMUNITY_URL=https://migajas-community.migajas-studio.workers.dev
