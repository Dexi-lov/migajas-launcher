{
  "name": "migajas-launcher",
  "version": "1.1.5",
  "description": "Launcher Oficial de Migajas Studio",
  "main": "main.js",
  "author": "Migajas Studio",
  "license": "MIT",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "build": "electron-builder",
    "build:all": "electron-builder -mw",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.migajas.launcher",
    "productName": "Migajas Launcher",
    "icon": "icon.png",
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.png",
      "category": "public.app-category.games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Migajas Launcher",
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Dexi-lov",
        "repo": "migajas-launcher",
        "releaseType": "release"
      }
    ],
    "files": [
      "**/*",
      "!**/minecraft/*",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/*.map",
      "!**/*.md"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "icon.png",
        "to": "icon.png"
      }
    ]
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "axios": "^1.6.0",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.1.7",
    "form-data": "^4.0.0",
    "minecraft-launcher-core": "latest",
    "msmc": "latest"
  },
  "devDependencies": {
    "electron": "^40.7.0",
    "electron-builder": "^26.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dexi-lov/migajas-launcher.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Dexi-lov/migajas-launcher/issues"
  },
  "homepage": "https://github.com/Dexi-lov/migajas-launcher#readme"
}