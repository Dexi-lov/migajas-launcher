{
  "name": "migajas-launcher",
  "version": "1.2.14",
  "description": "Launcher Oficial de Migajas Studio",
  "main": "main.js",
  "author": "Migajas Studio",
  "license": "MIT",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "build": "electron-builder",
    "build:all": "electron-builder -mw",
    "release": "node scripts/publicar.js",
    "publicar": "node scripts/publicar.js",
    "release:electron": "electron-builder --win --publish always",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "community:deploy": "wrangler deploy --config cloudflare/wrangler.json",
    "community:migrate": "wrangler d1 migrations apply migajas-community --remote --config cloudflare/wrangler.json",
    "community:test": "node scripts/test-community.cjs",
    "community:check": "tsc -p cloudflare/tsconfig.json",
    "test:ui": "node scripts/prepare-tauri-frontend.js && node scripts/test-launcher-ui.cjs",
    "test:session": "node scripts/test-social-session.cjs",
    "test:qr": "node scripts/test-mfa-qr.cjs",
    "test:packs": "node scripts/test-pack-inspector.cjs"
  },
  "build": {
    "appId": "com.migajas.launcher",
    "productName": "Migajas Launcher",
    "icon": "icon.PNG",
    "win": {
      "target": "nsis",
      "icon": "icon.PNG",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.PNG",
      "category": "public.app-category.games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Migajas Launcher",
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Dexi-lov",
        "repo": "migajas-launcher",
        "releaseType": "release"
      }
    ],
    "files": [
      "**/*",
      "!**/minecraft/*",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/*.map",
      "!**/*.md"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "icon.PNG",
        "to": "icon.png"
      }
    ]
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "2.4.0",
    "@supabase/supabase-js": "^2.57.4",
    "adm-zip": "^0.5.10",
    "axios": "^1.6.0",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.1.7",
    "fflate": "^0.8.3",
    "form-data": "^4.0.0",
    "md5": "^2.3.0",
    "minecraft-launcher-core": "latest",
    "msmc": "latest",
    "qrcode": "^1.5.4",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/md5": "^2.3.6",
    "electron": "^40.7.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "jsqr": "^1.4.0",
    "playwright": "^1.64.1",
    "supabase": "^2.122.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dexi-lov/migajas-launcher.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Dexi-lov/migajas-launcher/issues"
  },
  "homepage": "https://github.com/Dexi-lov/migajas-launcher#readme"
}
